# Copiar a .env y completar. Nunca commitear .env.

# local | test | production
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

# Implementación del agente: mock | llm
AGENT_IMPL=mock
# Segundos máximos de respuesta del agente por turno (Twilio espera ~15 s)
AGENT_TIMEOUT_S=12

# Banco simulado: escenario ficticio en app/modules/banking/fixtures/ (vacío = sin banco)
MOCK_BANK_SCENARIO=patricia

# Twilio (desde feat/twilio-webhook)
TWILIO_AUTH_TOKEN=
# URL pública exacta que Twilio llama, sin slash final.
# Ej: https://abcd.ngrok-free.app o https://contigo.up.railway.app
PUBLIC_BASE_URL=
# Solo para probar localmente con curl. No se puede desactivar con APP_ENV=production.
TWILIO_VALIDATE_SIGNATURE=true
