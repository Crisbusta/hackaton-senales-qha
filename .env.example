# Copiar a .env y completar. Nunca commitear .env.

# local | test | production
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

# Implementación del agente: mock | llm
AGENT_IMPL=mock
# Segundos máximos de respuesta del agente por turno (Twilio espera ~15 s)
AGENT_TIMEOUT_S=12

# Banco simulado: escenario ficticio en app/modules/banking/fixtures/ (vacío = sin banco)
MOCK_BANK_SCENARIO=patricia
# Números E.164 (coma) que pueden escribir /reiniciar para empezar de cero. Para la demo.
DEMO_ADMIN_NUMBERS=
# Contraseña del dashboard /dashboard (usuario cualquiera). Vacía = desactivado.
DASHBOARD_PASSWORD=

# PostgreSQL para guardar las conversaciones entre deploys. Vacía = en memoria (se
# pierden con cada reinicio). Ej: postgresql://usuario:clave@host:5432/base
DATABASE_URL=

# Notas de voz: transcripcion LOCAL con faster-whisper (el audio no sale del servidor).
# En el codigo vienen apagadas (sin el modelo en disco, el primer audio lo bajaria de
# Hugging Face); la imagen Docker trae el modelo horneado y las enciende. En local:
# VOICE_ENABLED=true usa el cache de Hugging Face (lo baja una vez, ~480 MB).
VOICE_ENABLED=false
VOICE_MODEL=small
# Carpeta del modelo ya descargado (en Docker: /app/models/faster-whisper-small).
VOICE_MODEL_DIR=
# Audios mas largos reciben un texto fijo, sin transcribir.
VOICE_MAX_SECONDS=60
# Plazo de descarga + transcripcion. Con la respuesta TwiML sincrona Twilio corta a ~15 s.
VOICE_TIMEOUT_S=20
# Hilos de CPU para Whisper (0 = automatico).
VOICE_CPU_THREADS=0

# Twilio (desde feat/twilio-webhook)
TWILIO_AUTH_TOKEN=
# Account SID (empieza con AC): necesario para descargar el PDF que envía el usuario.
TWILIO_ACCOUNT_SID=
# URL pública exacta que Twilio llama, sin slash final.
# Ej: https://abcd.ngrok-free.app o https://contigo.up.railway.app
PUBLIC_BASE_URL=
# Solo para probar localmente con curl. No se puede desactivar con APP_ENV=production.
TWILIO_VALIDATE_SIGNATURE=true

# OpenAI (cuando AGENT_IMPL=llm)
OPENAI_API_KEY=
# gpt-6.1-sol principal, gpt-6-luna de respaldo (empatados en precision,
# ~3,4-4,9 s de latencia). No usar modelos chicos: confunden rechazo_pausa
# con cierre, y eso cambia la rama del flujo.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_FALLBACK_MODEL=gpt-6-luna
OPENAI_TEMPERATURE=0.3
# Medido contra el proveedor real: p50 ~4,5 s, maximo 7,3 s en una
# respuesta valida. Con 6 s se cortaban respuestas buenas.
OPENAI_TIMEOUT_S=9
# El presupuesto del agente se deriva de AGENT_TIMEOUT_S menos este margen,
# que cubre validar, registrar y armar el TwiML. Una sola perilla: si el
# agente tuviera la suya y quedara mas alta, el backend lo cortaria antes.
AGENT_BUDGET_MARGIN_S=1

# Traza del agente: una linea JSONL por turno, para depurar y para el pitch.
# Guarda el mensaje completo y la respuesta con cifras, asi que viene
# apagada: encenderla solo en local y con datos de demo.
AGENT_TRACE_ENABLED=false
AGENT_TRACE_PATH=turnos.jsonl
